POSTGRES_DB=uproxx
POSTGRES_USER=uproxx
POSTGRES_PASSWORD=replace-with-a-long-unique-password
DATABASE_URL=postgresql://uproxx:replace-with-a-long-unique-password@postgres:5432/uproxx
APP_SESSION_SECRET=replace-with-at-least-32-random-characters
WEB_PORT=8080
MOCK_UPROX=false
# Same VM: use the U-PROX listener port, commonly 40001. Verify it on your installation.
UPROX_BASE_URL=http://127.0.0.1:40001
UPROX_USERNAME=
UPROX_PASSWORD=
UPROX_EMPLOYEE_DIRECTORY_LIMIT=2000
CONTROL_RATE_LIMIT_PER_MINUTE=12
# Hikvision NVR test preview. Keep the password only in the local .env file,
# never in the frontend or in version control. Channel 6 maps to camera 205 (D6).
HIKVISION_NVR_HOST=10.12.19.9
HIKVISION_NVR_USERNAME=
HIKVISION_NVR_PASSWORD=
HIKVISION_CAMERA_TEST_CHANNEL=6
# Full path may be needed on Windows, for example C:\\ffmpeg\\bin\\ffmpeg.exe
HIKVISION_FFMPEG_PATH=ffmpeg
